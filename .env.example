# ============================================================
#  CSIG Dashboard — Variables d'environnement
#  Copiez ce fichier en .env et remplissez les valeurs.
#  Ne commitez JAMAIS le fichier .env dans git.
# ============================================================

# --- Sécurité Django (OBLIGATOIRE) ---
# EN PRODUCTION (AWS ECS), DJANGO_SECRET_KEY, DATABASE_URL et REDIS_URL ne sont
# PAS définis ici : ils sont injectés par ECS depuis SSM Parameter Store
# (secrets[].valueFrom -> /csig/prod/django_secret_key, /database_url,
# /redis_url). Voir docs/AWS_DEPLOIEMENT_BOUT_EN_BOUT.md, étape 9.
DJANGO_SECRET_KEY=remplacer_par_une_cle_secrete_aleatoire_longue
# DJANGO_DEBUG=True
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,mondomaine.aws.ecs

# --- Compte admin initial (python manage.py create_admin) ---
DJANGO_ADMIN_PASSWORD=remplacer_par_un_mot_de_passe_fort
# DJANGO_ADMIN_EMAIL=admin@csig.com

# --- CSRF (origines supplémentaires séparées par des virgules) ---
# DJANGO_CSRF_TRUSTED_ORIGINS=https://mondomaine.com

# --- TLS / HSTS (appliqués seulement si DEBUG=False, défaut = 1 : mode sûr) ---
# 0 = désactiver, uniquement le temps d'une recette derrière un ALB en HTTP
# seul (avant que le certificat ACM ne soit sur l'écouteur 443). Sans cela,
# SECURE_SSL_REDIRECT renvoie une boucle de 301 et les cookies "Secure" ne sont
# jamais renvoyés par le navigateur => connexion impossible.
# Remettre à 1 (ou supprimer la variable) dès que le certificat est en place.
# DJANGO_SECURE_SSL=1
# DJANGO_HSTS=1

# --- URL publique (liens dans les emails) ---
SITE_URL=https://dashbord.csig.edu.gn

# --- Base de données ---
# Priorité: PostgreSQL (DATABASE_URL, ex. Amazon RDS) > SQLite

# Amazon RDS PostgreSQL (RECOMMANDÉ)
# DATABASE_URL=postgresql://user:password@rds-endpoint.region.rds.amazonaws.com:5432/csigdb?sslmode=require

# --- Redis / ElastiCache (InMemory utilisé si absent) ---
# REDIS_URL=redis://localhost:6379/0
# REDIS_URL=rediss://xxxxx.memorydb.region.amazonaws.com:6379  (ElastiCache TLS)

# --- Stockage média Amazon S3 + CloudFront (remplace Cloudinary) ---
# AWS_STORAGE_BUCKET_NAME=csig-media
# AWS_S3_REGION=us-east-1
# AWS_CLOUDFRONT_DOMAIN=d1234.cloudfront.net  (optionnel, sinon S3 direct)
# Credentials AWS : OPTIONNELLES, uniquement pour du dev local.
# Sur ECS Fargate, ne pas les definir : le role de tache csig-task-role
# fournit les credentials au conteneur (boto3 utilise sa chaine par defaut).

# --- Amazon SES (expéditeur des emails, prioritaire sur SendGrid/Outlook) ---
# AWS_SES_REGION=us-east-1   (région où le domaine est vérifié dans SES)
# L'expéditeur DOIT être un sous-domaine de l'identité SES verifiee, sinon la
# condition ses:FromAddress du rôle csig-task-role refuse l'envoi. Sur la prod :
#   DEFAULT_FROM_EMAIL=noreply@mail.dashbord.csig.edu.gn
# Pourquoi "mail." : dashbord.csig.edu.gn porte un CNAME vers l'ALB, et un nom
# qui porte un CNAME ne peut porter aucun autre enregistrement -> impossible d'y
# publier SPF/DKIM. L'identité SES est donc sur le sous-domaine "mail.".
# NB : compte SES encore en bac a sable -> pas d'envoi vers des adresses non
# verifiees tant que la sortie de bac a sable n'est pas accordee.
DEFAULT_FROM_EMAIL=noreply@mail.dashbord.csig.edu.gn

# --- Email Outlook / Office 365 (repli si pas de SES) ---
# IGNORE sur ECS tant que AWS_SES_REGION est defini (SES est prioritaire)
EMAIL_BACKEND=core.email_backend.OutlookSMTPBackend
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_LOCAL_HOSTNAME=csig.edu.gn
EMAIL_HOST_USER=support@csig.edu.gn
EMAIL_HOST_PASSWORD=remplacer_par_le_mot_de_passe_application_outlook
DEFAULT_FROM_EMAIL=support@csig.edu.gn

# --- Email alternatif via SendGrid (prioritaire sur Outlook si défini) ---
# SENDGRID_API_KEY=SG.xxxx
# DEFAULT_FROM_EMAIL=noreply@csig.edu.gn