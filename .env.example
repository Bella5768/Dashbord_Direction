# ============================================================
#  CSIG Dashboard — Variables d'environnement
#  Copiez ce fichier en .env et remplissez les valeurs.
#  Ne commitez JAMAIS le fichier .env dans git.
# ============================================================

# --- Sécurité Django (OBLIGATOIRE) ---
DJANGO_SECRET_KEY=remplacer_par_une_cle_secrete_aleatoire_longue
# DJANGO_DEBUG=True
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,mondomaine.onrender.com

# --- Compte admin initial (python manage.py create_admin) ---
DJANGO_ADMIN_PASSWORD=remplacer_par_un_mot_de_passe_fort
# DJANGO_ADMIN_EMAIL=admin@csig.com

# --- CSRF (origines supplémentaires séparées par des virgules) ---
# DJANGO_CSRF_TRUSTED_ORIGINS=https://mondomaine.com

# --- URL publique (liens dans les emails) ---
SITE_URL=http://localhost:8000

# --- Base de données ---
# Priorité: Neon PostgreSQL (DATABASE_URL) > MySQL > SQLite

# Neon PostgreSQL (RECOMMANDÉ - choix principal)
# DATABASE_URL=postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require

# MySQL (option de repli)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_DATABASE=csig_dashboard
# MYSQL_USER=csig_user
# MYSQL_PASSWORD=remplacer_par_le_mot_de_passe_mysql

# --- Redis (InMemory utilisé si absent) ---
# REDIS_URL=redis://localhost:6379/0

# --- Email Outlook / Office 365 ---
EMAIL_BACKEND=core.email_backend.OutlookSMTPBackend
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_LOCAL_HOSTNAME=csig.edu.gn
EMAIL_HOST_USER=support@csig.edu.gn
EMAIL_HOST_PASSWORD=remplacer_par_le_mot_de_passe_application_outlook
DEFAULT_FROM_EMAIL=support@csig.edu.gn

# --- Email alternatif via SendGrid (prioritaire sur Outlook si défini) ---
# SENDGRID_API_KEY=SG.xxxx
# DEFAULT_FROM_EMAIL=noreply@csig.edu.gn

# --- Cloudinary (stockage des médias) ---
CLOUDINARY_CLOUD_NAME=remplacer_par_votre_cloud_name
CLOUDINARY_API_KEY=remplacer_par_votre_api_key
CLOUDINARY_API_SECRET=remplacer_par_votre_api_secret
CLOUDINARY_UPLOAD_PRESET=remplacer_par_votre_upload_preset
